---
import Icon from './Icon.astro';
import { CONTACT } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Başlamak için doğru zamanı beklemenize gerek yok',
  text = 'Kısa bir ön görüşmeyle ihtiyacınıza uygun çalışma biçimini birlikte belirleyelim. Sorularınızı yanıtlamaktan memnuniyet duyarım.',
} = Astro.props;

const whatsapp = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`;
---

<section class="container-x py-20 md:py-24">
  <div class="reveal relative overflow-hidden rounded-5xl bg-pine-800 px-7 py-14 text-center md:px-16 md:py-20">
    <div class="pointer-events-none absolute inset-0 grain opacity-40"></div>
    <div class="pointer-events-none absolute -top-24 -right-16 size-72 rounded-full bg-pine-600/50 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-20 size-80 rounded-full bg-clay-500/25 blur-3xl"></div>

    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-3xl text-white sm:text-4xl">{title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-pine-100/85">{text}</p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={`tel:${CONTACT.phoneHref}`} class="btn w-full bg-sand-50 text-pine-800 hover:bg-white sm:w-auto">
          <Icon name="phone" size={18} />
          {CONTACT.phoneDisplay}
        </a>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener"
          class="btn w-full border border-pine-500 text-sand-100 hover:bg-pine-700 sm:w-auto"
        >
          <Icon name="whatsapp" size={18} />
          WhatsApp’tan yazın
        </a>
      </div>

      <p class="mt-6 text-sm text-pine-200/70">Genellikle aynı gün içinde dönüş yapılır.</p>
    </div>
  </div>
</section>
