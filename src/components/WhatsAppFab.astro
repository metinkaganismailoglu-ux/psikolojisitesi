---
import Icon from './Icon.astro';
import { CONTACT } from '../config/site';

const href = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="fixed right-5 bottom-5 z-50 flex items-center gap-2 rounded-full bg-pine-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lift transition-transform duration-300 hover:-translate-y-1 hover:bg-pine-700"
>
  <Icon name="whatsapp" size={20} />
  <span class="hidden sm:inline">WhatsApp’tan yazın</span>
  <span class="sr-only sm:hidden">WhatsApp’tan yazın</span>
</a>
