---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  text,
  align = 'left',
  as: Tag = 'h2',
  class: className = '',
}: Props = Astro.props;
---

<div
  class:list={[
    'reveal max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="mt-4 text-3xl leading-[1.15] text-pine-900 sm:text-4xl md:text-[2.6rem]">{title}</Tag>
  {text && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{text}</p>}
</div>
