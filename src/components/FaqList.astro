---
interface Props {
  faqs: readonly { q: string; a: string }[];
  class?: string;
}

const { faqs, class: className = '' } = Astro.props;
---

<div class:list={['divide-y divide-sand-200 overflow-hidden rounded-4xl border border-sand-200 bg-white', className]}>
  {
    faqs.map((faq, i) => (
      <details class="group" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 px-6 py-5 text-left font-display text-lg font-semibold text-pine-900 transition-colors hover:bg-sand-50 md:px-8">
          <span>{faq.q}</span>
          <span
            aria-hidden="true"
            class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-pine-50 text-pine-700 transition-transform duration-300 group-open:rotate-45"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </span>
        </summary>
        <div class="px-6 pb-6 text-[0.97rem] leading-relaxed text-ink-muted md:px-8">{faq.a}</div>
      </details>
    ))
  }
</div>
