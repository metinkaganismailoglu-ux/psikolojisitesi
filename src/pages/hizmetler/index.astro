---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { PROCESS } from '../../config/site';
import { getServices } from '../../lib/services';
import { serviceSchema } from '../../lib/schema';

const services = await getServices();
const breadcrumbs = [{ name: 'Hizmetler', path: '/hizmetler' }];

const schema = [
  {
    '@type': 'ItemList',
    name: 'Psikolojik danışmanlık hizmetleri',
    itemListElement: services.map((service, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: serviceSchema({
        title: service.data.title,
        description: service.data.description,
        path: `/hizmetler/${service.id}`,
      }),
    })),
  },
];
---

<BaseLayout
  title="Hizmetler"
  description="Çocuk psikoterapisi, ergen danışmanlığı, ebeveyn danışmanlığı, online terapi, psikolojik değerlendirme ve okul uyumu desteği."
  path="/hizmetler"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <PageHero
    eyebrow="Hizmetler"
    title="Her aileye ve her çocuğa özel planlanan çalışma alanları"
    text="Aşağıdaki başlıklar bir menü değil, bir başlangıç noktasıdır. Hangi çalışmanın uygun olduğuna ön görüşme ve değerlendirme sonrasında birlikte karar veririz."
    breadcrumbs={breadcrumbs}
  />

  <section class="container-x py-16 md:py-24">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <ServiceCard
            title={service.data.shortTitle}
            description={service.data.description}
            href={`/hizmetler/${service.id}`}
            icon={service.data.icon}
            meta={service.data.ageRange}
            delay={(i % 3) * 90}
          />
        ))
      }
    </div>
  </section>

  <section class="bg-white/60 py-16 md:py-24">
    <div class="container-x">
      <SectionHeading
        eyebrow="Süreç"
        title="Nasıl ilerliyoruz?"
        text="Hangi hizmeti seçerseniz seçin, süreç aynı şeffaf adımlarla ilerler."
        align="center"
      />

      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          PROCESS.map((step, i) => (
            <li class="reveal card h-full p-7" data-delay={i * 80}>
              <span class="font-display text-5xl font-semibold text-pine-100">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-3 font-display text-xl font-semibold text-pine-900">{step.title}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
