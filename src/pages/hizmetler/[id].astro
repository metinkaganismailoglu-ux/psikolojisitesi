---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { getServices } from '../../lib/services';
import { faqSchema, serviceSchema } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const { Content } = await render(service);

const path = `/hizmetler/${service.id}`;
const breadcrumbs = [
  { name: 'Hizmetler', path: '/hizmetler' },
  { name: service.data.shortTitle, path },
];

const others = (await getServices()).filter((item) => item.id !== service.id).slice(0, 3);

const schema = [
  serviceSchema({ title: service.data.title, description: service.data.description, path }),
  ...(service.data.faqs.length ? [faqSchema(service.data.faqs)] : []),
];

const meta = [
  { icon: 'users', label: 'Yaş aralığı', value: service.data.ageRange },
  { icon: 'clock', label: 'Seans', value: service.data.duration },
  { icon: 'screen', label: 'Format', value: service.data.format },
];
---

<BaseLayout
  title={service.data.title}
  description={service.data.description}
  path={path}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <PageHero
    eyebrow="Hizmet"
    title={service.data.title}
    text={service.data.description}
    breadcrumbs={breadcrumbs}
  >
    <dl class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        meta.map((item) => (
          <div class="flex items-center gap-3 rounded-3xl border border-sand-200 bg-white px-5 py-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-pine-50 text-pine-600">
              <Icon name={item.icon} size={20} />
            </span>
            <div>
              <dt class="text-xs font-semibold tracking-[0.1em] text-ink-muted uppercase">{item.label}</dt>
              <dd class="mt-0.5 text-sm font-semibold text-pine-900">{item.value}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <section class="container-x py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.35fr_0.65fr]">
      <div
        class="prose prose-lg reveal max-w-none prose-headings:font-display prose-headings:text-pine-900 prose-p:text-ink-muted prose-li:text-ink-muted prose-strong:text-ink prose-a:text-pine-700"
      >
        <Content />
      </div>

      <aside class="space-y-6">
        <div class="reveal card p-7">
          <p class="font-display text-lg font-semibold text-pine-900">Kimler için uygun?</p>
          <ul class="mt-5 space-y-3">
            {
              service.data.forWhom.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-muted">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-pine-100 text-pine-700">
                    <Icon name="check" size={14} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal card bg-pine-800 p-7 text-sand-100" data-delay="100">
          <p class="font-display text-lg font-semibold text-white">Uygun mu, birlikte bakalım</p>
          <p class="mt-3 text-sm leading-relaxed text-pine-100/85">
            Emin değilseniz kısa bir ön görüşme yapalım. Gerekirse sizi doğru uzmana yönlendiririm.
          </p>
          <a href="/iletisim" class="btn mt-6 w-full bg-sand-50 text-pine-800 hover:bg-white">
            Randevu talebi
            <Icon name="arrow" size={18} />
          </a>
        </div>

        <div class="reveal card p-7" data-delay="160">
          <p class="font-display text-lg font-semibold text-pine-900">Diğer hizmetler</p>
          <ul class="mt-4 space-y-1">
            {
              others.map((item) => (
                <li>
                  <a
                    href={`/hizmetler/${item.id}`}
                    class="flex items-center justify-between gap-3 rounded-2xl px-3 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-sand-100 hover:text-pine-800"
                  >
                    {item.data.shortTitle}
                    <Icon name="arrow" size={16} class="text-pine-600" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    service.data.faqs.length > 0 && (
      <section class="container-x pb-8">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
          <div class="reveal">
            <p class="eyebrow">S.S.S.</p>
            <h2 class="mt-4 text-3xl text-pine-900">Bu hizmetle ilgili sorular</h2>
          </div>
          <FaqList faqs={service.data.faqs} class="reveal" />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
