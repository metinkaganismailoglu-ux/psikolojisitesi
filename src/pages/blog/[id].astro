---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/services';
import { articleSchema, faqSchema } from '../../lib/schema';
import { SITE } from '../../config/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prev: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

const path = `/blog/${post.id}`;
const breadcrumbs = [
  { name: 'Blog', path: '/blog' },
  { name: post.data.title, path },
];

const dateFormatter = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((heading) => heading.depth === 2);

const schema = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    path,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
  }),
  ...(post.data.faqs.length ? [faqSchema(post.data.faqs)] : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={path}
  ogType="article"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <article>
    <header class="border-b border-sand-200 bg-pine-50/60">
      <div class="container-x py-14 md:py-20">
        <nav aria-label="Sayfa yolu" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-muted">
            <li><a href="/" class="hover:text-pine-700">Ana Sayfa</a></li>
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              <a href="/blog" class="hover:text-pine-700">Blog</a>
            </li>
          </ol>
        </nav>

        <p class="eyebrow bg-white">{post.data.category}</p>
        <h1 class="mt-5 max-w-4xl text-4xl leading-[1.12] text-pine-900 sm:text-5xl">{post.data.title}</h1>

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-muted">
          <span class="font-medium text-pine-800">{SITE.name}</span>
          <time datetime={post.data.publishedAt.toISOString()}>{dateFormatter.format(post.data.publishedAt)}</time>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="clock" size={15} />
            {post.data.readingTime} dk okuma
          </span>
        </div>
      </div>
    </header>

    <div class="container-x py-14 md:py-20">
      <div class="grid gap-12 lg:grid-cols-[0.28fr_0.72fr]">
        <aside class="lg:sticky lg:top-28 lg:self-start">
          {
            toc.length > 0 && (
              <nav aria-label="İçindekiler" class="reveal rounded-4xl border border-sand-200 bg-white p-6">
                <p class="text-xs font-semibold tracking-[0.12em] text-ink-muted uppercase">İçindekiler</p>
                <ol class="mt-4 space-y-2.5 text-sm">
                  {toc.map((heading) => (
                    <li>
                      <a href={`#${heading.slug}`} class="text-ink-muted transition-colors hover:text-pine-700">
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </aside>

        <div>
          <div class="reveal rounded-4xl border border-pine-200 bg-pine-50 p-7">
            <p class="text-xs font-semibold tracking-[0.12em] text-pine-700 uppercase">Kısa yanıt</p>
            <p class="mt-3 text-lg leading-relaxed text-pine-900">{post.data.answer}</p>
          </div>

          <div
            class="prose prose-lg reveal mt-10 max-w-none prose-headings:font-display prose-headings:text-pine-900 prose-p:text-ink-muted prose-li:text-ink-muted prose-strong:text-ink prose-a:text-pine-700 prose-blockquote:border-pine-300 prose-blockquote:text-ink"
          >
            <Content />
          </div>

          {
            post.data.tags.length > 0 && (
              <ul class="mt-10 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li class="rounded-full bg-sand-100 px-4 py-1.5 text-sm text-ink-muted">#{tag}</li>
                ))}
              </ul>
            )
          }

          {
            post.data.faqs.length > 0 && (
              <section class="mt-14">
                <h2 class="text-2xl text-pine-900">Sık sorulan sorular</h2>
                <FaqList faqs={post.data.faqs} class="mt-6" />
              </section>
            )
          }

          <div class="mt-12 rounded-4xl border border-sand-200 bg-white p-7">
            <p class="text-sm leading-relaxed text-ink-muted">
              <strong class="text-ink">Not:</strong> Bu yazı genel bilgilendirme amacıyla hazırlanmıştır ve bireysel
              değerlendirmenin yerini tutmaz. Çocuğunuzla ilgili endişeleriniz varsa bir uzmanla görüşmeniz önerilir.
            </p>
          </div>

          <nav class="mt-10 grid gap-4 sm:grid-cols-2">
            {
              prev && (
                <a href={`/blog/${prev.id}`} class="card group p-6 transition-transform duration-300 hover:-translate-y-1">
                  <span class="text-xs font-semibold tracking-[0.12em] text-ink-muted uppercase">Önceki yazı</span>
                  <p class="mt-2 font-display text-lg font-semibold text-pine-900">{prev.data.title}</p>
                </a>
              )
            }
            {
              next && (
                <a
                  href={`/blog/${next.id}`}
                  class="card group p-6 transition-transform duration-300 hover:-translate-y-1 sm:text-right"
                >
                  <span class="text-xs font-semibold tracking-[0.12em] text-ink-muted uppercase">Sonraki yazı</span>
                  <p class="mt-2 font-display text-lg font-semibold text-pine-900">{next.data.title}</p>
                </a>
              )
            }
          </nav>
        </div>
      </div>
    </div>
  </article>

  <CtaBand
    title="Yazıdaki durum size tanıdık geldiyse"
    text="Çocuğunuzun yaşadığı zorluğu birlikte değerlendirelim. Ön görüşme için yazmanız yeterli."
  />
</BaseLayout>
