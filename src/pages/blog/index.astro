---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts } from '../../lib/services';
import { SITE } from '../../config/site';

const posts = await getPosts();
const breadcrumbs = [{ name: 'Blog', path: '/blog' }];

const dateFormatter = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@type': 'Blog',
    name: `${SITE.name} — Blog`,
    description: 'Çocuk ve ergen psikolojisi üzerine ebeveynler için yazılar.',
    url: new URL('/blog', SITE.url).href,
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      url: new URL(`/blog/${post.id}`, SITE.url).href,
      datePublished: post.data.publishedAt.toISOString(),
    })),
  },
];

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog"
  description="Çocuk ve ergen psikolojisi üzerine ebeveynler için yazılar: okul reddi, öfke nöbetleri, sınav kaygısı, terapi süreci ve daha fazlası."
  path="/blog"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <PageHero
    eyebrow="Blog"
    title="Ebeveynler için yazılar"
    text="Görüşmelerde en sık karşılaştığım soruları, klinik deneyimden süzülmüş ve evde uygulanabilir yanıtlarla ele alıyorum."
    breadcrumbs={breadcrumbs}
  />

  <section class="container-x py-16 md:py-24">
    {
      featured && (
        <article class="reveal card group relative grid gap-8 overflow-hidden p-8 md:grid-cols-[1.3fr_0.7fr] md:p-12">
          <div>
            <div class="flex flex-wrap items-center gap-3 text-xs font-semibold tracking-[0.12em] text-clay-600 uppercase">
              <span>{featured.data.category}</span>
              <span class="text-sand-300" aria-hidden="true">
                •
              </span>
              <span class="text-ink-muted">{featured.data.readingTime} dk okuma</span>
            </div>

            <h2 class="mt-4 text-3xl leading-tight text-pine-900 sm:text-4xl">
              <a href={`/blog/${featured.id}`} class="after:absolute after:inset-0 after:content-['']">
                {featured.data.title}
              </a>
            </h2>
            <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">{featured.data.description}</p>
            <p class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-pine-700">
              Yazıyı oku
              <Icon name="arrow" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
            </p>
          </div>

          <div class="rounded-4xl bg-pine-50 p-6">
            <p class="text-xs font-semibold tracking-[0.12em] text-pine-700 uppercase">Kısa yanıt</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{featured.data.answer}</p>
          </div>
        </article>
      )
    }

    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((post, i) => (
          <article
            class="reveal group card relative flex h-full flex-col p-7 transition-transform duration-300 hover:-translate-y-1.5"
            data-delay={(i % 3) * 90}
          >
            <div class="flex items-center gap-3 text-xs font-semibold tracking-[0.12em] text-clay-600 uppercase">
              <span>{post.data.category}</span>
            </div>
            <h2 class="mt-3 font-display text-xl leading-snug text-pine-900">
              <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{post.data.description}</p>
            <div class="mt-6 flex items-center justify-between gap-4 border-t border-sand-200 pt-5 text-xs text-ink-muted">
              <time datetime={post.data.publishedAt.toISOString()}>{dateFormatter.format(post.data.publishedAt)}</time>
              <span class="inline-flex items-center gap-1.5">
                <Icon name="clock" size={14} />
                {post.data.readingTime} dk
              </span>
            </div>
          </article>
        ))
      }
    </div>

    {posts.length === 0 && <p class="text-ink-muted">Yakında ilk yazı yayımlanacak.</p>}
  </section>

  <CtaBand />
</BaseLayout>
